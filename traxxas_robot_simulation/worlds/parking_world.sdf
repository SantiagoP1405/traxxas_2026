<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="parking_world">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link_ground">
        <collision name="collision_ground">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual_ground">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="banqueta">
      <static>true</static>
      <pose>0 0.8 0.1 0 0 0</pose> 
      <link name="link_banqueta">
        <collision name="collision_banqueta">
          <geometry>
            <box>
              <size>3.0 0.4 1.0</size> 
            </box>
          </geometry>
        </collision>
        <visual name="visual_banqueta">
          <geometry>
            <box>
              <size>3.0 0.4 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_rear">
      <pose>-0.9 0.35 0.15 0 0 1.57</pose>
      <static>true</static>
      <link name="link_box_rear">
        <collision name="collision_box_rear">
          <geometry>
            <box>
              <size>0.5 0.35 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual_box_rear">
          <geometry>
            <box>
              <size>0.5 0.35 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse> 
          </material>
        </visual>
      </link>
    </model>

    <model name="box_mid_limit_back">
      <pose>-0.5 0.35 0.15 0 0 1.57</pose>
      <static>true</static>
      <link name="link_box_mid_back">
        <collision name="collision_box_mid_back">
          <geometry>
            <box>
              <size>0.5 0.35 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual_box_mid_back">
          <geometry>
            <box>
              <size>0.5 0.35 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_mid_limit_front">
      <pose>0.5 0.35 0.15 0 0 1.57</pose>
      <static>true</static>
      <link name="link_box_mid_front">
        <collision name="collision_box_mid_front">
          <geometry>
            <box>
              <size>0.5 0.35 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual_box_mid_front">
          <geometry>
            <box>
              <size>0.5 0.35 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_front">
      <pose>0.9 0.35 0.15 0 0 1.57</pose>
      <static>true</static>
      <link name="link_box_front">
        <collision name="collision_box_front">
          <geometry>
            <box>
              <size>0.5 0.35 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual_box_front">
          <geometry>
            <box>
              <size>0.5 0.35 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>