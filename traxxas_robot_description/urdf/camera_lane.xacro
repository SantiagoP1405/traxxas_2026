<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Basic camera properties -->
        <xacro:property name="base_height" value="0.02434" />
        <xacro:property name="base_length" value="${zed_length}" />
        <xacro:property name="base_width" value="0.057" />
        <xacro:property name="base_mass" value="0.005" />
        <xacro:property name="camera_length" value="0.0096" />
        <xacro:property name="camera_width" value="0.06823" />
        <xacro:property name="camera_height" value="0.045" />
        <xacro:property name="lens_radius" value="0.00974" />
        <xacro:property name="lens_offset" value="0.0172" />

    <!-- Links -->
    <link name="camera_base_link">
        <xacro:box_inertia l="${base_length}" w="${base_width}" h="${base_height}" m="${base_mass}" o_xyz="0.0 0.0 0.0" o_rpy="0.0 0.0 0.0"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
        </collision>
    </link>

    <link name="camera_link_optical" />

    <link name="camera_link">
        <xacro:box_inertia l="${camera_length}" w="${camera_width}" h="${camera_height}" m="0.088" o_xyz="0.0 0.0 0.0" o_rpy="0.0 0.0 0.0"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <material name="grey_dark" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
        </collision>
    </link>

    <link name="camera_pose_link">
        <xacro:cylinder_inertia m="0.01" r="0.003" l="${base_width}" o_xyz="0.0 0.0 0.0" o_rpy="${pi/2} 0.0 0.0" />
        <visual>
           <origin xyz="0.0 0.0 0.0" rpy="${pi / 2.0} 0.0 0.0" />
            <geometry>
                <cylinder radius="0.003" length="${base_width}" />
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0" />
            <geometry>
                <cylinder radius="0.003" length="${base_width}" />
            </geometry>
        </collision>
    </link>

    <link name="camera_lens_link">
        <xacro:cylinder_inertia m="0.002" r="${lens_radius}" l="0.001" o_xyz="0.0 0.0 0.0" o_rpy="0 ${pi/2} 0" />
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 ${pi/2} 0" />
            <geometry>
                <cylinder radius="${lens_radius}" length="0.001" />
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 ${pi/2} 0" />
            <geometry>
                <sphere radius="${lens_radius}" />
            </geometry>
        </collision>
    </link>

    <!-- Joints -->
    <joint name="zed_to_base" type="fixed">
        <parent link="zed2_camera_link" />
        <child link="camera_base_link" />
        <origin xyz="${-zed_length/2} 0 ${zed_height/2 + base_height/2}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="camera_pose_joint" type="fixed">
        <parent link="camera_base_link" />
        <child link="camera_pose_link" />
        <origin xyz="${base_length/2} 0 ${base_height/2}" rpy="0 ${pi/9} 0" />
        <axis xyz="0 1 0" />
        <!-- <limit lower="${-pi/4}" upper="${pi/4}" effort="1.0" velocity="1.0" /> -->
    </joint>

    <joint name="camera_pose_to_camera_joint" type="fixed">
        <parent link="camera_pose_link" />
        <child link="camera_link" />
        <origin xyz="${camera_length/2 + 0.003} 0 ${camera_height/2 - 0.003}" rpy="0 0 0" />
        <axis xyz="1 0 0" />
    </joint>

    <joint name="camera_to_lens_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_lens_link" />
        <origin xyz="${camera_length/2 + 0.001} 0 ${(camera_height/2) - lens_offset}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="lens_to_optical" type="fixed">
        <parent link="camera_lens_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Gazebo camera plugin -->
    <gazebo reference="camera_lens_link">
        <sensor type="camera" name="camera_lane_follower">
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.001</stddev>
                </noise>
                <optical_frame_id>camera_link_optical</optical_frame_id>
                <camera_info_topic>camera_lane_follower/camera_info</camera_info_topic>
            </camera>
            <always_on>true</always_on>
            <update_rate>30.0</update_rate>
            <visualize>true</visualize>
            <topic>camera_lane_follower/image_raw</topic>
            <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin> -->
        </sensor>
    </gazebo>

</robot>