<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Lidar base basic properties -->
    <xacro:property name="lidar_base_length" value="0.0616" />
    <xacro:property name="lidar_base_width" value="0.1163" />
    <xacro:property name="lidar_base_height" value="0.00644" />
    <!-- Lidar sensor basic properties -->
    <xacro:property name="lidar_sensor_radius" value="0.038" />
    <xacro:property name="lidar_sensor_height" value="0.04286" />

    <!-- Links -->
    <link name="lidar_base_link">
        <xacro:box_inertia m="0.1" l="${lidar_base_length}" w="${lidar_base_width}" h="${lidar_base_height}" o_xyz="0.0 0.0 ${lidar_base_height/2}" o_rpy="0.0 0.0 0.0" />
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${lidar_base_length} ${lidar_base_width} ${lidar_base_height}" />
            </geometry>
            <material name="white" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${lidar_base_length} ${lidar_base_width} ${lidar_base_height}" />
            </geometry>
        </collision>
    </link>

    <link name="lidar_link">
        <xacro:cylinder_inertia m="0.1" r="${lidar_sensor_radius}" l="${lidar_sensor_height}" o_xyz="0.0 0.0 0.0" o_rpy="0.0 0.0 0.0"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${lidar_sensor_radius}" length="${lidar_sensor_height}" />
            </geometry>
            <material name="grey_dark" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${lidar_sensor_radius}" length="${lidar_sensor_height}" />
            </geometry>
        </collision>
    </link>

    <!-- Joints -->
    <joint name="chassis_to_lidar_base_joint" type="fixed">
        <parent link="chassis_link" />
        <child link="lidar_base_link" />
        <origin xyz="${-chassis_length/2 + lidar_base_length/2 + 0.025} 0 ${chassis_height + lidar_base_height/2}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="lidar_base_to_lidar_joint" type="fixed">
        <parent link="lidar_base_link" />
        <child link="lidar_link" />
        <origin xyz="${lidar_sensor_radius - lidar_base_length/2} 0 ${lidar_base_height/2 + lidar_sensor_height/2}" rpy="0 0 0" />
    </joint>

    <!-- Gazebo LiDAR sensor plugin -->
    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <always_on>true</always_on>
            <pose>0 0 ${lidar_sensor_height/2 - 0.0087} 0 0 0</pose>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>/traxxas/scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>320</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>30.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
            <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin> -->
        </sensor>
    </gazebo>
</robot> 