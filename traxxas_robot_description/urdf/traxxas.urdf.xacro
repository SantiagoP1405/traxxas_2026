<?xml version="1.0" encoding="UTF-8"?>
<robot name="traxxas_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find traxxas_robot_description)/urdf/common_properties.xacro" />
    <xacro:include filename="$(find traxxas_robot_description)/urdf/mobile_base.xacro" />
    <xacro:include filename="$(find traxxas_robot_description)/urdf/mobile_base_gazebo.xacro" />

    <!-- The original design does not include any camera nor lidar. 
    To edit original design, comment the following lines.  -->
    <xacro:include filename="$(find traxxas_robot_description)/urdf/zed2.xacro" />
</robot>